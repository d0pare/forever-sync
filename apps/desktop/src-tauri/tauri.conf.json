{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forever Sync",
  "version": "0.5.0",
  "identifier": "io.github.d0pare.foreversync",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Forever Sync",
        "width": 900,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Sync WoW Forever settings across your computers",
    "longDescription": "Keeps World of Warcraft: Forever settings (SavedVariables, keybindings, macros) the same on all your computers using a private GitHub repository you own. Not affiliated with Blizzard Entertainment.",
    "copyright": "Not affiliated with Blizzard Entertainment.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1MDEyQUVBNkFFNDYzMEQKUldRTlkrUnE2aW9CQlRrcStDOGxsbG12U0RFTS84dTZoSDNkaUxyMDFHQWtDUGs1MjhmMytqVUwK",
      "endpoints": [
        "https://github.com/d0pare/forever-sync/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
